<!doctype html>
<html>

<head>
  <meta charset="utf8">
  <script>try{var d=document.documentElement,v=localStorage.getItem('ceepee.vibe')||'aurora';d.setAttribute('data-vibe',v);var c=localStorage.getItem('ceepee.corners');if(c)d.setAttribute('data-corners',c);var m=localStorage.getItem('ceepee.motion');if(m)d.setAttribute('data-motion',m)}catch(e){}</script>
  <title>CeePee</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0E0F10">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/ceepee/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/ceepee/favicon.svg">
  <link rel="shortcut icon" href="/huly/favicon.ico" sizes="any" id="default-favicon">
  <style>
    /* Boot screen: shown until the app mounts, then faded out by main.ts. */
    #ceepee-boot { position: fixed; inset: 0; z-index: 99999; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; background: #0b0c10; color: #e9ecf1; font: 14px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; overflow: hidden; transition: opacity .55s ease, visibility .55s; }
    #ceepee-boot.out { opacity: 0; visibility: hidden; }
    #ceepee-boot .grid { position: absolute; inset: -40%; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 64px 64px; transform: perspective(600px) rotateX(58deg) translateY(120px); animation: boot-grid 14s linear infinite; mask-image: radial-gradient(ellipse at 50% 60%, #000 20%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at 50% 60%, #000 20%, transparent 70%); }
    @keyframes boot-grid { from { background-position: 0 0, 0 0; } to { background-position: 0 64px, 0 64px; } }
    #ceepee-boot .aurora { position: absolute; inset: -30%; pointer-events: none; filter: blur(60px); background: radial-gradient(35% 30% at 30% 40%, rgba(192,240,16,.22), transparent 70%), radial-gradient(30% 35% at 72% 60%, rgba(43,107,234,.26), transparent 70%), radial-gradient(25% 25% at 55% 25%, rgba(106,69,245,.18), transparent 70%); animation: boot-aurora 10s ease-in-out infinite alternate; }
    @keyframes boot-aurora { from { transform: translate(-3%, 2%) rotate(0deg); } to { transform: translate(3%, -2%) rotate(6deg); } }
    #ceepee-boot .stars { position: absolute; inset: 0; background-image: radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,.7), transparent), radial-gradient(1px 1px at 70% 20%, rgba(255,255,255,.5), transparent), radial-gradient(1.5px 1.5px at 40% 70%, rgba(255,255,255,.6), transparent), radial-gradient(1px 1px at 85% 75%, rgba(255,255,255,.5), transparent), radial-gradient(1px 1px at 10% 85%, rgba(255,255,255,.4), transparent), radial-gradient(1px 1px at 60% 45%, rgba(255,255,255,.5), transparent); animation: boot-twinkle 4s ease-in-out infinite alternate; }
    @keyframes boot-twinkle { from { opacity: .5; } to { opacity: 1; } }
    #ceepee-boot .orb { position: relative; width: 132px; height: 132px; perspective: 600px; }
    #ceepee-boot .core { position: absolute; inset: 42px; border-radius: 50%; background: radial-gradient(circle at 38% 38%, #fff, #c0f010 45%, rgba(192,240,16,0) 72%); box-shadow: 0 0 24px #c0f010, 0 0 80px rgba(192,240,16,.35); animation: boot-pulse 1.8s ease-in-out infinite; }
    @keyframes boot-pulse { 0%, 100% { transform: scale(.88); } 50% { transform: scale(1.08); } }
    #ceepee-boot .ring { position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid transparent; border-top-color: rgba(233,236,241,.9); border-right-color: rgba(233,236,241,.25); transform-style: preserve-3d; }
    #ceepee-boot .r1 { animation: boot-r1 2.2s linear infinite; }
    #ceepee-boot .r2 { inset: 14px; border-top-color: #c0f010; border-right-color: rgba(192,240,16,.3); animation: boot-r2 3s linear infinite; }
    #ceepee-boot .r3 { inset: 28px; border-top-color: #4f8bff; border-right-color: rgba(79,139,255,.3); animation: boot-r3 1.6s linear infinite reverse; }
    @keyframes boot-r1 { from { transform: rotateX(64deg) rotateZ(0); } to { transform: rotateX(64deg) rotateZ(360deg); } }
    @keyframes boot-r2 { from { transform: rotateY(64deg) rotateZ(0); } to { transform: rotateY(64deg) rotateZ(360deg); } }
    @keyframes boot-r3 { from { transform: rotateZ(0); } to { transform: rotateZ(360deg); } }
    #ceepee-boot .word { position: relative; font-size: 28px; font-weight: 800; letter-spacing: .34em; text-indent: .34em; background: linear-gradient(90deg, #e9ecf1 0%, #c0f010 45%, #4f8bff 60%, #e9ecf1 100%); background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: boot-shimmer 3.2s linear infinite; }
    @keyframes boot-shimmer { from { background-position: 220% 0; } to { background-position: -220% 0; } }
    #ceepee-boot { --vibe-a: #7c3aed; --vibe-b: #ec4899; --vibe-c: #f97316; }
    html[data-vibe="ocean"] #ceepee-boot { --vibe-a: #0ea5e9; --vibe-b: #6366f1; --vibe-c: #22d3ee; }
    html[data-vibe="sunset"] #ceepee-boot { --vibe-a: #f97316; --vibe-b: #ec4899; --vibe-c: #a21caf; }
    html[data-vibe="lime"] #ceepee-boot { --vibe-a: #2b6bea; --vibe-b: #6a45f5; --vibe-c: #c0f010; }
    html[data-vibe="mono"] #ceepee-boot { --vibe-a: #2b6bea; --vibe-b: #2b6bea; --vibe-c: #2b6bea; }
    #ceepee-boot .word svg { display: block; height: 40px; width: auto; overflow: visible; filter: drop-shadow(0 0 16px rgba(168,85,247,.35)); }
    #ceepee-boot .word .g { stroke-dasharray: 420; animation: boot-draw 1.1s cubic-bezier(.2,.8,.3,1) both; animation-delay: calc(.15s + var(--i, 0) * .12s); }
    #ceepee-boot .word .s { stroke-dasharray: 130; animation: boot-streak .9s cubic-bezier(.2,.8,.3,1) both; animation-delay: .95s; }
    #ceepee-boot .word .core { transform-origin: 50px 50px; animation: boot-breathe 3.2s ease-in-out infinite; }
    @keyframes boot-draw { from { stroke-dashoffset: 420; opacity: .2; } to { stroke-dashoffset: 0; opacity: 1; } }
    @keyframes boot-streak { from { stroke-dashoffset: 130; opacity: 0; } to { stroke-dashoffset: 0; opacity: 1; } }
    @keyframes boot-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.12); } }
    #ceepee-boot .line { position: relative; width: 240px; height: 2px; border-radius: 2px; background: rgba(255,255,255,.08); overflow: hidden; }
    html[data-vibe="aurora"] #ceepee-boot .word { background-image: linear-gradient(90deg, #e9ecf1 0%, #a855f7 40%, #ec4899 55%, #f97316 65%, #e9ecf1 100%); }
    html[data-vibe="ocean"] #ceepee-boot .word { background-image: linear-gradient(90deg, #e9ecf1 0%, #22d3ee 45%, #6366f1 60%, #e9ecf1 100%); }
    html[data-vibe="sunset"] #ceepee-boot .word { background-image: linear-gradient(90deg, #e9ecf1 0%, #f97316 45%, #ec4899 60%, #e9ecf1 100%); }
    html[data-vibe="aurora"] #ceepee-boot .line::after { background: linear-gradient(90deg, transparent, #a855f7, #ec4899, #f97316, transparent); }
    html[data-vibe="ocean"] #ceepee-boot .line::after { background: linear-gradient(90deg, transparent, #22d3ee, #6366f1, transparent); }
    html[data-vibe="sunset"] #ceepee-boot .line::after { background: linear-gradient(90deg, transparent, #f97316, #ec4899, transparent); }
    #ceepee-boot .line::after { content: ""; position: absolute; top: 0; left: -40%; width: 40%; height: 100%; background: linear-gradient(90deg, transparent, #c0f010, #4f8bff, transparent); animation: boot-scan 1.6s ease-in-out infinite; }
    @keyframes boot-scan { to { left: 100%; } }
    #ceepee-boot .phase { position: relative; min-height: 1.4em; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: rgba(233,236,241,.6); }
    #ceepee-boot .phase b { color: #c0f010; font-weight: 600; }
    @media (prefers-reduced-motion: reduce) { #ceepee-boot * { animation-duration: 8s !important; } }
  </style>
</head>

<body style="margin: 0; overflow: hidden;">
  <div id="ceepee-boot" role="status" aria-live="polite">
    <div class="grid"></div>
    <div class="aurora"></div>
    <div class="stars"></div>
    <div class="orb"><span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span><span class="core"></span></div>
    <div class="word" aria-label="CeePee"><svg viewBox="0 0 660 100" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="bg-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" style="stop-color: var(--vibe-a, #7c3aed)"/><stop offset=".55" style="stop-color: var(--vibe-b, #ec4899)"/><stop offset="1" style="stop-color: var(--vibe-c, #f97316)"/></linearGradient><linearGradient id="bg-streak" x1="0" y1="0" x2="1" y2="0"><stop offset="0" style="stop-color: var(--vibe-c, #f97316)"/><stop offset="1" style="stop-color: var(--vibe-c, #f97316)" stop-opacity="0"/></linearGradient><path id="bg-orbit" d="M 94 50 A 44 15 0 1 1 6 50 A 44 15 0 1 1 94 50" transform="rotate(-28 50 50)"/></defs><use href="#bg-orbit" fill="none" stroke="url(#bg-grad)" stroke-width="6"/><circle class="core" cx="50" cy="50" r="13" fill="url(#bg-grad)"/><circle class="core" cx="50" cy="50" r="5" fill="#fff" fill-opacity=".9"/><circle r="5.5" fill="#fff"><animateMotion dur="5s" repeatCount="indefinite"><mpath href="#bg-orbit"/></animateMotion></circle><g fill="none" stroke="url(#bg-grad)" stroke-width="13" stroke-linejoin="miter"><path class="g" style="--i:0" d="M182 24 L170 12 H134 L122 24 V76 L134 88 H170 L182 76"/><path class="g" style="--i:1" d="M264 12 H216 L204 24 V76 L216 88 H264 M204 50 H252"/><path class="g" style="--i:2" d="M346 12 H298 L286 24 V76 L298 88 H346 M286 50 H334"/><path class="g" style="--i:3" d="M368 88 V24 L380 12 H416 L428 24 V40 L416 52 H368"/><path class="g" style="--i:4" d="M510 12 H462 L450 24 V76 L462 88 H510 M450 50 H498"/><path class="g" style="--i:5" d="M592 12 H544 L532 24 V76 L544 88 H592"/></g><path class="s" d="M532 50 H655" fill="none" stroke="url(#bg-streak)" stroke-width="13"/></svg></div>
    <div class="line"></div>
    <div class="phase" id="ceepee-boot-phase">Waking the workspace</div>
  </div>
  <script>
    (function () {
      var phases = ['Waking the workspace', 'Loading your projects', 'Syncing issues and boards', 'Warming the automation engine', 'Almost there'];
      var i = 0; var el = document.getElementById('ceepee-boot-phase');
      var t = setInterval(function () { i = (i + 1) % phases.length; if (el) el.textContent = phases[i]; }, 1800);
      window.__ceepeeBootDone = function () {
        clearInterval(t);
        var b = document.getElementById('ceepee-boot');
        if (!b) return;
        b.classList.add('out');
        setTimeout(function () { b.remove(); }, 700);
      };
      setTimeout(function () { if (window.__ceepeeBootDone) window.__ceepeeBootDone(); }, 25000);
    })();
  </script>
</body>

</html>
