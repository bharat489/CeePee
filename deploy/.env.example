# CeePee production settings. Copy to deploy/.env and fill in. Never commit the filled file.

# --- hostnames (DNS A records must point at this server) ---
DOMAIN=ceepee.example.com
API_DOMAIN=api.ceepee.example.com

# --- images: where deploy.sh pushes and the server pulls from ---
IMAGE_PREFIX=ghcr.io/bharat489/ceepee
IMAGE_TAG=latest
# deploy.sh: where to ssh, and which workspaces to upgrade after each release
SERVER=
SERVER_DIR=/opt/ceepee
WORKSPACES=

# --- secrets: generate each with  openssl rand -hex 32  ---
SERVER_SECRET=change-me
MINIO_ROOT_USER=ceepee
MINIO_ROOT_PASSWORD=change-me
PUSH_AUTH_TOKEN=change-me

# --- web push (npx web-push generate-vapid-keys) ---
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@ceepee.example.com

# --- integrations service account: a workspace member (Maintainer) created for the bots ---
INTEGRATIONS_WORKSPACE=
INTEGRATIONS_EMAIL=
INTEGRATIONS_PASSWORD=
INBOUND_TOKEN=
SCIM_TOKEN=
HEARTBEAT_MINUTES=5

# --- outbound email (optional but recommended: invites, recovery, digests, customer replies) ---
# Any SMTP works: Zoho Mail, Brevo, Gmail app password, SES.
MAIL_SOURCE=noreply@ceepee.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=upgrade

# --- portal ---
PORTAL_NAME=Help centre
PORTAL_COLOR=#a855f7
PORTAL_PROJECT=
PORTAL_LANG=en

# --- optional bots ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_SECRET=
# --- GIF search in chat (optional): tenor (free key from Google Cloud) or giphy ---
GIF_PROVIDER=tenor
GIF_API_KEY=
# --- free AI for "Ask CeePee" (optional) ---
# Any OpenAI-compatible chat endpoint. Ollama on the same box is free and private:
#   curl -fsSL https://ollama.com/install.sh | sh && ollama pull llama3.2
#   AI_CHAT_URL=http://172.17.0.1:11434   (the docker bridge address of the host)
# Leave empty and the assistant still answers from your own data, with no model at all.
AI_CHAT_URL=
AI_CHAT_MODEL=llama3.2
